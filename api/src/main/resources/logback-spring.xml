<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de Logback de la API (la usa Spring Boot por llamarse logback-spring.xml).

  - Consola: siempre, con el formato por defecto de Spring Boot.
  - Archivo rotativo: solo con el perfil "postgres" (docker compose). Se guarda en ${LOG_DIR} (por defecto ./logs),
    rota por día y por tamaño, y conserva 14 días. Si la carpeta no se puede escribir, Logback lo informa y la API
    sigue funcionando solo con la consola.
  - No se registran contraseñas, tokens ni datos de salud: los mensajes de la API solo llevan identificadores.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <springProfile name="postgres">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/medicitas-api.log</file>
            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/medicitas-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>200MB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="postgres">
            <appender-ref ref="FILE"/>
        </springProfile>
    </root>

    <!-- El código propio registra en INFO; Hibernate y Spring Security solo avisos y errores. -->
    <logger name="com.medicitas" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
</configuration>
