@startuml
title 10 - Modelo físico (Diagrama Entidad-Relación) - MediCitas Anglo (PostgreSQL 15)

' ---------------------------------------------------------------
' Convenciones
'  *  columna obligatoria (NOT NULL)
'  PK clave primaria · FK clave foránea · UK restricción de unicidad
'  CK restricción CHECK · IX índice
'  Tipos de PostgreSQL. Los instantes usan la zona horaria de Lima (UTC-5).
'  Fuente de verdad: api/src/main/resources/db/migration/V1__init_schema.sql
' ---------------------------------------------------------------

hide circle
hide empty methods
skinparam linetype ortho
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #0B4FB0
skinparam ArrowThickness 1.2
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1069E5
  HeaderBackgroundColor #E4EEFD
  FontColor #0F1E33
  AttributeFontColor #0F1E33
  StereotypeFontColor #56698A
}
skinparam package {
  BackgroundColor #F4F7FC
  BorderColor #B6C9E4
  FontColor #0B4FB0
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #D9B45A
  FontColor #3D3321
}

package "Catálogo de la clínica" {

  entity "location" as location {
    * id : BIGSERIAL <<PK>>
    --
    * code : VARCHAR(10) <<UK>>
    * name : VARCHAR(100)
    * address : VARCHAR(200)
    * district : VARCHAR(60)
    phone : VARCHAR(20)
    * active : BOOLEAN = true
    ..
    UK uk_location_code (code)
  }

  entity "specialty" as specialty {
    * id : BIGSERIAL <<PK>>
    --
    * name : VARCHAR(120) <<UK>>
    description : TEXT
    * appointment_minutes : SMALLINT = 20
    * active : BOOLEAN = true
    ..
    UK uk_specialty_name (name)
    CK ck_specialty_minutes (appointment_minutes > 0)
  }

  entity "location_specialty" as location_specialty {
    * location_id : BIGINT <<PK, FK>>
    * specialty_id : BIGINT <<PK, FK>>
    --
    * active : BOOLEAN = true
  }

  entity "doctor" as doctor {
    * id : BIGSERIAL <<PK>>
    --
    * license : VARCHAR(10) <<UK>>
    specialist_registry : VARCHAR(10)
    * first_names : VARCHAR(100)
    * last_names : VARCHAR(100)
    * specialty_id : BIGINT <<FK>>
    * active : BOOLEAN = true
    ..
    UK uk_doctor_license (license)
  }
}

package "Pacientes y seguros" {

  entity "patient" as patient {
    * id : BIGSERIAL <<PK>>
    --
    * document_type : VARCHAR(3)
    * document_number : VARCHAR(12)
    * first_names : VARCHAR(100)
    * last_names : VARCHAR(100)
    * birth_date : DATE
    sex : CHAR(1)
    * phone : VARCHAR(15)
    * email : VARCHAR(120)
    * accepts_notifications : BOOLEAN = true
    * registered_at : TIMESTAMPTZ = now()
    ..
    UK uk_patient_document (document_type, document_number)
    CK ck_patient_document_type: DNI · CE · PAS
    CK ck_patient_sex: NULL · M · F
  }

  entity "insurer" as insurer {
    * id : BIGSERIAL <<PK>>
    --
    * name : VARCHAR(100) <<UK>>
    * ruc : CHAR(11) <<UK>>
    * type : VARCHAR(15)
    * active : BOOLEAN = true
    ..
    UK uk_insurer_name (name)
    UK uk_insurer_ruc (ruc)
  }

  entity "insurance_plan" as plan {
    * id : BIGSERIAL <<PK>>
    --
    * insurer_id : BIGINT <<FK>>
    * name : VARCHAR(80)
    consultation_copay : NUMERIC(8,2)
    * active : BOOLEAN = true
    ..
    UK uk_plan_insurer_name (insurer_id, name)
  }

  entity "patient_insurance" as patient_insurance {
    * id : BIGSERIAL <<PK>>
    --
    * patient_id : BIGINT <<FK>>
    * plan_id : BIGINT <<FK>>
    policy_number : VARCHAR(30)
    * coverage_status : VARCHAR(12)
    valid_until : DATE
    ..
    UK uk_patient_insurance_plan (patient_id, plan_id)
    CK ck_patient_insurance_status:
    ACTIVE · SUSPENDED · EXPIRED
  }
}

package "Agenda y citas" {

  entity "slot" as slot {
    * id : BIGSERIAL <<PK>>
    --
    * doctor_id : BIGINT <<FK>>
    * location_id : BIGINT <<FK>>
    * date : DATE
    * start_time : TIME
    * end_time : TIME
    room : VARCHAR(20)
    * status : VARCHAR(10) = 'FREE'
    * version : INTEGER = 0
    ..
    UK uk_slot_doctor_schedule (doctor_id, date, start_time)
    CK ck_slot_times (end_time > start_time)
    CK ck_slot_status: FREE · BOOKED · BLOCKED
    IX ix_slot_availability (location_id, date, status)
  }

  entity "appointment" as appointment {
    * id : BIGSERIAL <<PK>>
    --
    * code : VARCHAR(12) <<UK>>
    * patient_id : BIGINT <<FK>>
    * slot_id : BIGINT <<FK>>
    patient_insurance_id : BIGINT <<FK>>
    * visit_reason : VARCHAR(250)
    * status : VARCHAR(12) = 'BOOKED'
    * booking_channel : VARCHAR(10)
    * idempotency_key : UUID <<UK>>
    * reschedule_count : SMALLINT = 0
    * booked_at : TIMESTAMPTZ = now()
    * updated_at : TIMESTAMPTZ = now()
    ..
    UK uk_appointment_code (code)
    UK uk_appointment_idempotency_key (idempotency_key)
    UK uk_appointment_slot_booked (slot_id) WHERE status = 'BOOKED'
    CK ck_appointment_status:
    BOOKED · CANCELLED · ATTENDED · NO_SHOW
    CK ck_appointment_channel: KIOSK · FRONT_DESK
    CK ck_appointment_reschedules (reschedule_count >= 0)
    IX ix_appointment_patient_status (patient_id, status)
  }

  entity "appointment_history" as history {
    * id : BIGSERIAL <<PK>>
    --
    * appointment_id : BIGINT <<FK>>
    * event : VARCHAR(15)
    previous_status : VARCHAR(12)
    * new_status : VARCHAR(12)
    previous_slot_id : BIGINT <<FK>>
    new_slot_id : BIGINT <<FK>>
    user_id : BIGINT <<FK>>
    detail : VARCHAR(250)
    * event_at : TIMESTAMPTZ = now()
    ..
    CK ck_appointment_history_event:
    BOOKING · RESCHEDULE · CANCELLATION · ATTENDANCE
    IX ix_appointment_history_appointment (appointment_id)
  }
}

package "Notificaciones" {

  entity "notification" as notification {
    * id : BIGSERIAL <<PK>>
    --
    * appointment_id : BIGINT <<FK>>
    * type : VARCHAR(15)
    * channel : VARCHAR(5)
    * destination : VARCHAR(120)
    * scheduled_for : TIMESTAMPTZ
    sent_at : TIMESTAMPTZ
    * status : VARCHAR(10) = 'PENDING'
    * attempts : SMALLINT = 0
    provider_message_id : VARCHAR(80)
    error_detail : VARCHAR(250)
    ..
    CK ck_notification_type:
    CONFIRMATION · REMINDER · RESCHEDULE · CANCELLATION
    CK ck_notification_channel: EMAIL · SMS
    CK ck_notification_status:
    PENDING · SENT · FAILED · CANCELLED
    CK ck_notification_attempts (attempts >= 0)
    IX ix_notification_pending (status, scheduled_for)
  }
}

package "Seguridad y auditoría (Ley 29733)" {

  entity "app_user" as app_user {
    * id : BIGSERIAL <<PK>>
    --
    * username : VARCHAR(50) <<UK>>
    * password_hash : VARCHAR(72)
    * role : VARCHAR(15)
    doctor_id : BIGINT <<FK, UK>>
    * active : BOOLEAN = true
    last_access : TIMESTAMPTZ
    ..
    UK uk_app_user_username (username)
    UK uk_app_user_doctor (doctor_id)
    CK ck_app_user_role: ADMIN · FRONT_DESK · DOCTOR
    password_hash almacena un hash BCrypt
  }

  entity "audit_log" as audit_log {
    * id : BIGSERIAL <<PK>>
    --
    user_id : BIGINT <<FK>>
    * action : VARCHAR(60)
    * entity : VARCHAR(40)
    entity_id : BIGINT
    detail : TEXT
    source_ip : VARCHAR(45)
    * registered_at : TIMESTAMPTZ = now()
  }
}

' ---------------------------------------------------------------
' Relaciones (las FK figuran en cada entidad)
' ---------------------------------------------------------------
location ||--o{ location_specialty : ofrece
specialty ||--o{ location_specialty : se ofrece en
specialty ||--o{ doctor : agrupa

doctor ||--o{ slot : atiende
location ||--o{ slot : aloja

insurer ||--|{ plan : vende
plan ||--o{ patient_insurance : cubre
patient ||--o{ patient_insurance : se afilia a

patient ||--o{ appointment : solicita
slot ||--o{ appointment : es tomado por
patient_insurance |o--o{ appointment : paga

appointment ||--|{ history : registra
appointment ||--o{ notification : genera
slot |o--o{ history : cupo anterior / nuevo

doctor |o--o| app_user : inicia sesión como
app_user |o--o{ audit_log : realiza
app_user |o--o{ history : ejecuta

' ---------------------------------------------------------------
' Dominios y reglas de negocio
' ---------------------------------------------------------------
note bottom of slot
  <b>status</b>: FREE · BOOKED · BLOCKED
  <b>version</b>: bloqueo optimista. Si dos reservas llegan a la vez,
  solo una actualiza la fila; la otra recibe
  409 SLOT_NOT_AVAILABLE (RF-07).
  Los cupos los crea el Administrador (CU-024, RF-31).
end note

note bottom of appointment
  <b>status</b>: BOOKED · CANCELLED · ATTENDED · NO_SHOW
  <b>booking_channel</b>: KIOSK (Paciente) · FRONT_DESK (Admisión)
  Un paciente no puede tener dos citas BOOKED que se crucen
  en fecha y hora (RF-08).
  <b>idempotency_key</b>: reintentar la misma reserva devuelve
  la cita ya creada (RNF-07).
  ATTENDED y NO_SHOW los registra el Médico (CU-015, RF-22).
end note

note bottom of notification
  <b>type</b>: CONFIRMATION · REMINDER · RESCHEDULE · CANCELLATION
  <b>channel</b>: EMAIL · SMS
  <b>status</b>: PENDING · SENT · FAILED · CANCELLED (RF-13)
  Un fallo del proveedor nunca cambia la cita (RF-14).
end note

note bottom of history
  <b>event</b>: BOOKING · RESCHEDULE · CANCELLATION · ATTENDANCE
  user_id es NULL cuando el Paciente actúa desde el Kiosco;
  lleva el usuario del Backoffice cuando actúa Admisión
  (FRONT_DESK) o el Médico (ATTENDANCE).
end note

note bottom of audit_log
  <b>action</b>: LOGIN · LOGOUT · APPOINTMENT_BOOKED ·
  APPOINTMENT_RESCHEDULED · APPOINTMENT_CANCELLED ·
  ATTENDANCE_REGISTERED · USER_CREATED · USER_UPDATED ·
  DOCTOR_UPDATED · SPECIALTY_UPDATED · SLOTS_GENERATED ...
  <b>entity</b>: nombre de la tabla afectada; <b>entity_id</b> su id.
end note

@enduml
