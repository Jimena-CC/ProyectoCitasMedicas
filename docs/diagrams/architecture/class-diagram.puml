@startuml
title Diagrama de Clases - MediCitas Anglo

' ---------------------------------------------------------------
' Convenciones
'  Paquetes "Dominio", "Servicios" y "REST" reflejan el código real de
'  api/src/main/java/com/medicitas/api (Fase 1, en producción).
'  El paquete "Backoffice (Fase 2)" contiene las clases nuevas que
'  implementan seguridad, auditoría, agenda del médico, admisión,
'  administración y reportes; sus métodos corresponden a los endpoints
'  /auth, /doctor, /front-desk, /admin y /admin/reports.
' ---------------------------------------------------------------

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam nodesep 15
skinparam ranksep 35
skinparam ArrowColor #0B4FB0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1069E5
  HeaderBackgroundColor #E4EEFD
  FontColor #0F1E33
  AttributeFontColor #0F1E33
  BorderColor<<Fase 2>> #B4413C
  HeaderBackgroundColor<<Fase 2>> #FDECEA
}
skinparam package {
  BackgroundColor #F4F7FC
  BorderColor #B6C9E4
  FontColor #0B4FB0
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FFF8E6
  BorderColor #D9B45A
  FontColor #3D3321
}

' ---------------------------------------------------------------
' Enumeraciones
' ---------------------------------------------------------------
package "Enumeraciones" as PkgEnums {
  enum DocumentType {
    DNI
    CE
    PAS
  }
  enum CoverageStatus {
    ACTIVE
    SUSPENDED
    EXPIRED
  }
  enum SlotStatus {
    FREE
    BOOKED
    BLOCKED
  }
  enum AppointmentStatus {
    BOOKED
    CANCELLED
    ATTENDED
    NO_SHOW
  }
  enum AppointmentEvent {
    BOOKING
    RESCHEDULE
    CANCELLATION
    ATTENDANCE
  }
  enum BookingChannel {
    KIOSK
    FRONT_DESK
  }
  enum NotificationType {
    CONFIRMATION
    REMINDER
    RESCHEDULE
    CANCELLATION
  }
  enum NotificationChannel {
    EMAIL
    SMS
  }
  enum NotificationStatus {
    PENDING
    SENT
    FAILED
    CANCELLED
  }
  enum UserRole <<Fase 2>> {
    ADMIN
    FRONT_DESK
    DOCTOR
  }
}

' ---------------------------------------------------------------
' Dominio (entidades JPA)
' ---------------------------------------------------------------
package "Dominio" as PkgDomain {

  class Location {
    - id : Long
    - code : String
    - name : String
    - address : String
    - district : String
    - phone : String
    - active : boolean
  }

  class Specialty {
    - id : Long
    - name : String
    - description : String
    - appointmentMinutes : Short
    - active : boolean
  }

  class LocationSpecialty {
    - id : LocationSpecialty.Id
    - active : boolean
  }

  class Doctor {
    - id : Long
    - license : String
    - specialistRegistry : String
    - firstNames : String
    - lastNames : String
    - active : boolean
    + getFullName() : String
  }

  class Patient {
    - id : Long
    - documentType : DocumentType
    - documentNumber : String
    - firstNames : String
    - lastNames : String
    - birthDate : LocalDate
    - sex : String
    - phone : String
    - email : String
    - acceptsNotifications : boolean
    - registeredAt : Instant
    + getFullName() : String
  }

  class Insurer {
    - id : Long
    - name : String
    - ruc : String
    - type : String
    - active : boolean
  }

  class InsurancePlan {
    - id : Long
    - name : String
    - consultationCopay : BigDecimal
    - active : boolean
  }

  class PatientInsurance {
    - id : Long
    - policyNumber : String
    - coverageStatus : CoverageStatus
    - validUntil : LocalDate
    + isActiveOn(today : LocalDate) : boolean
    + getCoverageDescription() : String
  }

  class Slot {
    - id : Long
    - date : LocalDate
    - startTime : LocalTime
    - endTime : LocalTime
    - room : String
    - status : SlotStatus
    - version : Integer
    + getStart() : LocalDateTime
    + startAt(zone : ZoneId) : Instant
    + setStatus(status : SlotStatus) : void
  }

  class Appointment {
    - id : Long
    - code : String
    - visitReason : String
    - status : AppointmentStatus
    - bookingChannel : BookingChannel
    - idempotencyKey : UUID
    - rescheduleCount : Short
    - bookedAt : Instant
    - updatedAt : Instant
    + reschedule(newSlot : Slot, now : Instant) : void
    + cancel(now : Instant) : void
    + registerAttendance(status : AppointmentStatus, now : Instant) : void
  }

  class AppointmentHistory {
    - id : Long
    - event : AppointmentEvent
    - previousStatus : AppointmentStatus
    - newStatus : AppointmentStatus
    - userId : Long
    - detail : String
    - eventAt : Instant
    + {static} record(appointment, event, previousStatus,\n      newStatus, previousSlot, newSlot, detail, eventAt) : AppointmentHistory
  }

  class Notification {
    - id : Long
    - type : NotificationType
    - channel : NotificationChannel
    - destination : String
    - scheduledFor : Instant
    - sentAt : Instant
    - status : NotificationStatus
    - attempts : Short
    - providerMessageId : String
    - errorDetail : String
    + {static} create(appointment, type, channel, destination, scheduledFor) : Notification
    + markSent(now : Instant, providerMessageId : String) : void
    + recordFailure(now, detail, maxAttempts, retryWait) : void
    + cancel() : void
  }

  class AppUser <<Fase 2>> {
    - id : Long
    - username : String
    - passwordHash : String
    - role : UserRole
    - active : boolean
    - lastAccess : Instant
    + hasRole(role : UserRole) : boolean
    + touchLastAccess(now : Instant) : void
  }

  class AuditLog <<Fase 2>> {
    - id : Long
    - action : String
    - entity : String
    - entityId : Long
    - detail : String
    - sourceIp : String
    - registeredAt : Instant
    + {static} of(user, action, entity, entityId,\n      detail, sourceIp, now) : AuditLog
  }
}

' ---------------------------------------------------------------
' Servicios de aplicación (Fase 1)
' ---------------------------------------------------------------
package "Servicios" as PkgServices {

  class PatientService {
    + findByDocument(documentType, documentNumber) : PatientResponse
    + register(request : PatientRequest) : PatientResponse
    + updateInsurance(patientId : Long, request : InsuranceRequest) : PatientResponse
  }

  class CatalogService {
    + listLocations() : List<LocationResponse>
    + listSpecialties(locationId : Long) : List<SpecialtyResponse>
    + listInsurers() : List<InsurerResponse>
  }

  class AvailabilityService {
    - MAX_DAYS : int = 14
    + query(specialtyId, locationId, from, to) : AvailabilityResponse
  }

  class AppointmentService {
    + book(request : AppointmentRequest, idempotencyKey : UUID) : BookingResult
    + listByPatient(patientId, onlyUpcoming) : List<AppointmentResponse>
    + reschedule(appointmentId, request) : AppointmentResponse
    + cancel(appointmentId, reason) : AppointmentResponse
  }

  class AppointmentCodeGenerator {
    + generate() : String
  }

  class NotificationService {
    + scheduleForBooking(appointment : Appointment) : List<Long>
    + scheduleForReschedule(appointment : Appointment) : List<Long>
    + scheduleForCancellation(appointment : Appointment) : List<Long>
    + send(notificationId : Long) : void
    + duePendingIds() : List<Long>
    + listByAppointment(appointmentId : Long) : List<NotificationResponse>
  }

  class ScheduledNotificationsJob {
    + processPending() : void
  }

  class ImmediateSendListener {
    + sendAfterCommit(event : NotificationsToSendEvent) : void
  }

  interface MessagingClient {
    + send(message : OutgoingMessage) : String
  }

  class SimulatedMessagingClient implements MessagingClient {
    - simulateFailure : boolean
    + send(message : OutgoingMessage) : String
  }
}

' ---------------------------------------------------------------
' Controladores REST (Fase 1) - base /api/v1
' ---------------------------------------------------------------
package "REST (Fase 1)" as PkgRest {
  class PatientController {
    + GET /patients
    + POST /patients
    + PUT /patients/{id}/insurance
  }
  class CatalogController {
    + GET /locations
    + GET /specialties
    + GET /insurers
  }
  class AvailabilityController {
    + GET /availability
  }
  class AppointmentController {
    + POST /appointments
    + GET /patients/{id}/appointments
    + PATCH /appointments/{id}/reschedule
    + PATCH /appointments/{id}/cancellation
  }
  class NotificationController {
    + GET /appointments/{id}/notifications
  }
}

' ---------------------------------------------------------------
' Backoffice web (Fase 2) - base /api/v1
' ---------------------------------------------------------------
package "Backoffice (Fase 2)" as PkgBackoffice {

  class AuthService <<Fase 2>> {
    + login(username, password, sourceIp) : AuthToken
    + logout(token : String) : void
    + currentUser() : AppUser
  }

  class AuditService <<Fase 2>> {
    + record(action, entity, entityId, detail) : void
    + search(filter : AuditFilter, page : Pageable) : Page<AuditLogResponse>
  }

  class DoctorAgendaService <<Fase 2>> {
    + agendaOfDay(date : LocalDate) : List<AgendaItemResponse>
    + registerAttendance(appointmentId : Long, status : AppointmentStatus) : AgendaItemResponse
  }

  class FrontDeskService <<Fase 2>> {
    + searchPatient(documentType, documentNumber) : PatientResponse
    + registerPatient(request : PatientRequest) : PatientResponse
    + validateInsurance(patientId : Long) : InsuranceValidationResponse
    + book(request, idempotencyKey) : BookingResult
    + reschedule(appointmentId, request) : AppointmentResponse
    + cancel(appointmentId, reason) : AppointmentResponse
  }

  class AdminCatalogService <<Fase 2>> {
    + listUsers() : List<UserResponse>
    + createUser(request) / updateUser(id, request) : UserResponse
    + deactivateUser(id) : void
    + createDoctor(request) / updateDoctor(id, request) : DoctorResponse
    + createSpecialty(request) / updateSpecialty(id, request) : SpecialtyResponse
    + generateSlots(request : SlotGenerationRequest) : List<SlotResponse>
    + blockSlot(slotId) : SlotResponse
  }

  class ReportService <<Fase 2>> {
    + appointmentsByStatus(from, to) : AppointmentsReport
    + noShowRate(from, to) : NoShowRateReport
    + occupancyBySpecialty(from, to) : List<OccupancyRow>
    + exportCsv(report, from, to) : byte[]
  }

  class AuthController <<Fase 2>> {
    + POST /auth/login
    + POST /auth/logout
    + GET /auth/me
  }
  class DoctorAgendaController <<Fase 2>> {
    + GET /doctor/agenda
    + PATCH /doctor/appointments/{id}/attendance
  }
  class FrontDeskController <<Fase 2>> {
    + GET /front-desk/patients
    + POST /front-desk/patients
    + GET /front-desk/patients/{id}/insurance
    + POST /front-desk/appointments
    + PATCH /front-desk/appointments/{id}/reschedule
    + PATCH /front-desk/appointments/{id}/cancellation
  }
  class AdminController <<Fase 2>> {
    + GET|POST|PUT /admin/users
    + GET|POST|PUT /admin/doctors
    + GET|POST|PUT /admin/specialties
    + GET|POST /admin/slots
    + GET /admin/audit
  }
  class ReportController <<Fase 2>> {
    + GET /admin/reports/appointments
    + GET /admin/reports/no-show-rate
    + GET /admin/reports/occupancy
    + GET /admin/reports/export
  }
}

' ---------------------------------------------------------------
' Relaciones del dominio
' ---------------------------------------------------------------
Location "1" -- "0..*" LocationSpecialty
Specialty "1" -- "0..*" LocationSpecialty
Specialty "1" -- "0..*" Doctor : agrupa >
Doctor "1" -- "0..*" Slot : atiende >
Location "1" -- "0..*" Slot : aloja >

Insurer "1" *-- "1..*" InsurancePlan : plans >
InsurancePlan "1" -- "0..*" PatientInsurance
Patient "1" -- "0..*" PatientInsurance

Patient "1" -- "0..*" Appointment : solicita >
PatientInsurance "0..1" -- "0..*" Appointment : paga >
Slot "1" -- "0..*" Appointment : es tomado por >
Appointment "1" *-- "1..*" AppointmentHistory : registra >
Appointment "1" *-- "0..*" Notification : genera >
Slot "0..1" -- "0..*" AppointmentHistory : cupo anterior / nuevo >

Doctor "0..1" -- "0..1" AppUser : inicia sesión como >
AppUser "0..1" -- "0..*" AuditLog : realiza >

' ---------------------------------------------------------------
' Dependencias de servicios (Fase 1)
' ---------------------------------------------------------------
PatientController ..> PatientService
CatalogController ..> CatalogService
AvailabilityController ..> AvailabilityService
AppointmentController ..> AppointmentService
NotificationController ..> NotificationService

PatientService ..> Patient : gestiona
AvailabilityService ..> Slot : consulta
AppointmentService ..> Appointment : crea y modifica
AppointmentService ..> Slot : toma y libera
AppointmentService ..> AppointmentHistory : registra
AppointmentService ..> AppointmentCodeGenerator : genera código
AppointmentService ..> NotificationService : programa
NotificationService ..> Notification : procesa
NotificationService ..> MessagingClient : delega envío
ScheduledNotificationsJob ..> NotificationService : cada 5 min
ImmediateSendListener ..> NotificationService : tras confirmar la transacción

' ---------------------------------------------------------------
' Dependencias del Backoffice (Fase 2)
' [norank] evita que estas dependencias suban el paquete por encima del dominio
' ---------------------------------------------------------------
AuthController ..> AuthService
DoctorAgendaController ..> DoctorAgendaService
FrontDeskController ..> FrontDeskService
AdminController ..> AdminCatalogService
AdminController ..> AuditService : consulta
ReportController ..> ReportService

AuthService -[norank]-> AppUser : valida BCrypt y emite JWT
AuthService ..> AuditService : LOGIN / LOGOUT
AuditService -[norank]-> AuditLog : escribe
DoctorAgendaService -[norank]-> Appointment : ATTENDED / NO_SHOW\n+ evento ATTENDANCE en AppointmentHistory
DoctorAgendaService ..> AuditService
FrontDeskService -[norank]-> AppointmentService : canal FRONT_DESK\n(reutiliza también PatientService)
FrontDeskService ..> AuditService
AdminCatalogService -[norank]-> Slot : genera y bloquea cupos\n(CRUD de AppUser, Doctor y Specialty)
AdminCatalogService ..> AuditService
ReportService -[norank]-> Appointment : agrega por estado y especialidad

' ---------------------------------------------------------------
' Disposición: enumeraciones en dos columnas, Backoffice debajo del dominio
' ---------------------------------------------------------------
DocumentType -[hidden]down- CoverageStatus
CoverageStatus -[hidden]down- SlotStatus
SlotStatus -[hidden]down- AppointmentStatus
AppointmentStatus -[hidden]down- AppointmentEvent
BookingChannel -[hidden]down- NotificationType
NotificationType -[hidden]down- NotificationChannel
NotificationChannel -[hidden]down- NotificationStatus
NotificationStatus -[hidden]down- UserRole
AppointmentHistory -[hidden]down- AuthController
Notification -[hidden]down- FrontDeskController
AuditLog -[hidden]down- AdminController

legend right
  <b>Leyenda</b>
  Borde azul: clases existentes en el código (Fase 1).
  Borde rojo <<Fase 2>>: clases nuevas del Backoffice web.
  Los controladores listan sus endpoints bajo /api/v1;
  los del Backoffice exigen token JWT y rol (RF-17, RF-18).
endlegend

@enduml
