@startuml
title 12 - Proceso propuesto (TO-BE) - Agendamiento en ventanilla por Personal de Admisión

skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #2F5D56
skinparam SwimlaneBorderColor #A9C4BD
skinparam SwimlaneTitleFontColor #0C6E5F
skinparam SwimlaneTitleFontStyle bold
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #13917D
  FontColor #17302B
  DiamondBackgroundColor #E3F4EF
  DiamondBorderColor #13917D
  StartColor #0C6E5F
  EndColor #0C6E5F
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #D9B45A
  FontColor #3D3321
}

' Orden de los carriles
|Paciente|
|Personal de Admisión|
|Backoffice web (React)|
|API MediCitas|
|Servicio de Mensajería|

|Paciente|
start
:Acudir a ventanilla o llamar a la central\ne indicar su tipo y número de documento;
-[#2F5D56,dashed]->

|Personal de Admisión|
:Ingresar el documento en "Buscar paciente" (CU-016);
note right
  Requiere sesión iniciada con rol FRONT_DESK
  (CU-011). Cada acción se audita (CU-013).
end note
-[#2F5D56,dashed]->

|Backoffice web (React)|
:Enviar GET /front-desk/patients?documentType&documentNumber;
-[#2F5D56,dashed]->

|API MediCitas|
:Validar token y rol FRONT_DESK (RF-17);
:Buscar al paciente por documento (RF-23);

if (¿Paciente registrado?) then (No)
  -[#2F5D56,dashed]->
  |Paciente|
  :Dictar datos personales y de contacto;
  -[#2F5D56,dashed]->
  |Personal de Admisión|
  :Registrar al paciente en el formulario;
  -[#2F5D56,dashed]->
  |Backoffice web (React)|
  :Validar formato y enviar POST /front-desk/patients\n(mismas reglas que RF-01);
  -[#2F5D56,dashed]->
  |API MediCitas|
  :Crear el paciente y registrar\nPATIENT_CREATED en audit_log;
else (Sí)
endif

-[#2F5D56,dashed]->
|Personal de Admisión|
if (¿El paciente usará su seguro?) then (Sí)
  :Indicar aseguradora y plan (CU-017);
  -[#2F5D56,dashed]->
  |Backoffice web (React)|
  :Enviar GET /front-desk/patients/{id}/insurance;
  -[#2F5D56,dashed]->
  |API MediCitas|
  :Verificar que la cobertura esté ACTIVE\ny vigente a la fecha (RF-24);
  if (¿Cobertura vigente?) then (No)
    :Responder 422 COVERAGE_NOT_ACTIVE;
    -[#2F5D56,dashed]->
    |Personal de Admisión|
    :Informar al paciente y ofrecer\natención particular;
  else (Sí)
    -[#2F5D56,dashed]->
    |Personal de Admisión|
    :Continuar con cobertura del seguro;
  endif
else (No)
  :Registrar atención particular;
endif

:Seleccionar especialidad, sede y fecha\nsegún lo que pide el paciente;
-[#2F5D56,dashed]->
|Backoffice web (React)|
:Enviar GET /availability (RF-05);
-[#2F5D56,dashed]->
|API MediCitas|
:Devolver cupos FREE futuros agrupados por médico;
-[#2F5D56,dashed]->

repeat
  |Personal de Admisión|
  :Ofrecer los horarios y elegir uno con el paciente;
  :Ingresar motivo de consulta y confirmar;
  -[#2F5D56,dashed]->
  |Backoffice web (React)|
  :Enviar POST /front-desk/appointments\ncon Idempotency-Key (CU-018);
  -[#2F5D56,dashed]->
  |API MediCitas|
  :Abrir transacción;
  :Verificar que el cupo sea futuro;
  :Tomar cupo actualizando su versión (RF-07);
  :Verificar cruce con otra cita del paciente (RF-08);
repeat while (¿Cupo tomado o cita duplicada? → 409) is (Sí, elegir otro horario)
->No;

|API MediCitas|
:Crear cita BOOKED con código único\ny booking_channel = FRONT_DESK (RF-25);
:Registrar evento BOOKING en appointment_history\ncon user_id del operador;
:Registrar APPOINTMENT_BOOKED en audit_log (CU-013);
:Programar notificaciones CONFIRMATION (inmediata)\ny REMINDER (24 h antes) (RF-11, RF-12);
:Confirmar transacción y responder 201;

fork
  -[#2F5D56,dashed]->
  |Backoffice web (React)|
  :Mostrar código de cita, médico, sede, fecha y hora;
  -[#2F5D56,dashed]->
  |Personal de Admisión|
  :Entregar el código y los datos de la cita al paciente;
fork again
  |API MediCitas|
  :Enviar confirmación al proveedor (RF-11);
  -[#2F5D56,dashed]->
  |Servicio de Mensajería|
  :Entregar correo de confirmación;
  note right
    Si el proveedor falla, la cita sigue BOOKED (RF-14)
    y se reintenta según el proceso 07.
  end note
end fork

-[#2F5D56,dashed]->
|Paciente|
:Recibir el código de la cita y la confirmación;
stop

@enduml
