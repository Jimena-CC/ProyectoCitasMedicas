@startuml
title 06 - Proceso propuesto (TO-BE) - Reprogramar una cita desde el Kiosko

skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #2F5D56
skinparam SwimlaneBorderColor #A9C4BD
skinparam SwimlaneTitleFontColor #0C6E5F
skinparam SwimlaneTitleFontStyle bold
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #13917D
  FontColor #17302B
  DiamondBackgroundColor #E3F4EF
  DiamondBorderColor #13917D
  StartColor #0C6E5F
  EndColor #0C6E5F
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #D9B45A
  FontColor #3D3321
}

' Orden de los carriles
|Paciente|
|Kiosko (JavaFX)|
|API MediCitas|
|Servicio de Mensajería|

|Paciente|
start
:Identificarse con su documento;
-[#2F5D56,dashed]->

|Kiosko (JavaFX)|
:Abrir "Mis citas";
-[#2F5D56,dashed]->

|API MediCitas|
:Listar citas BOOKED futuras\nGET /patients/{id}/appointments;

if (¿Tiene citas activas?) then (No)
  -[#2F5D56,dashed]->
  |Kiosko (JavaFX)|
  :Ofrecer reservar una nueva cita;
  stop
else (Sí)
endif
-[#2F5D56,dashed]->

|Paciente|
:Seleccionar la cita y elegir "Reprogramar";
-[#2F5D56,dashed]->

repeat
  |API MediCitas|
  :Consultar cupos FREE de la misma\nespecialidad y sede (RF-05);
  -[#2F5D56,dashed]->
  |Paciente|
  :Elegir nuevo horario;
  -[#2F5D56,dashed]->
  |Kiosko (JavaFX)|
  :Enviar PATCH /appointments/{id}/reschedule;
  -[#2F5D56,dashed]->
  |API MediCitas|
  :Validar que la cita esté BOOKED\ny que aún no haya iniciado;
  :Tomar el cupo nuevo actualizando su versión (RF-07);
  :Verificar cruce con otra cita del paciente (RF-08);
repeat while (¿Cupo tomado o cita duplicada? → 409) is (Sí, elegir otro horario)
->No;

:Liberar el cupo original (RF-09);
:Incrementar reschedule_count;
:Registrar evento RESCHEDULE\ncon cupo anterior y nuevo;
:Cancelar recordatorio pendiente\ny programar uno para la nueva fecha;
:Programar notificación RESCHEDULE;
-[#2F5D56,dashed]->

|Kiosko (JavaFX)|
:Mostrar la cita con su nueva fecha y hora;
-[#2F5D56,dashed]->

|Servicio de Mensajería|
:Entregar aviso de reprogramación;
-[#2F5D56,dashed]->

|Paciente|
:Recibir aviso por correo / SMS;
stop

@enduml
