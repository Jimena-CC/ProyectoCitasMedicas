# --- Base de Datos PostgreSQL ---
POSTGRES_DB=citas_medicas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro

# --- Seguridad Backend (Spring Boot) ---
SECURITY_JWT_SECRET=tu_clave_secreta_super_larga_y_segura_minimo_32_caracteres
SECURITY_JWT_EXPIRATION_MS=480

# --- CORS: Orígenes permitidos (Aquí incluimos tanto tu puerto de Docker como el local por si acaso) ---
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- Auditoría ---
SECURITY_AUDIT_TRUST_FORWARDED_FOR=false

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api/v1
VITE_IDLE_MINUTES=30